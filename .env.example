# ==============================================================================
# CompliCal — BALAJI GROUPS Local Server Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local for local server deployment.

# Node Environment & Network Binding
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Security & Authentication (MANDATORY: Minimum 32-character secure secret key)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-minimum-32-characters
ADMIN_PASSWORD=replace-with-a-secure-admin-password

# Application Settings
NEXT_TELEMETRY_DISABLED=1

# Email Notifications (SMTP configuration for statutory compliance alerts)
SMTP_HOST=mail.yourcompany.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="CompliCal Alerts <alerts@yourcompany.com>"
SMTP_SECURE=false

# Database Path (Optional override - defaults to ./data/compliance.db)
DATABASE_PATH=./data/compliance.db
