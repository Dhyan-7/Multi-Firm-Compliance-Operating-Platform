# ==============================================================================
# ComplianceOS — Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local for local development, or configure these
# environment variables in your AWS App Runner / ECS / Elastic Beanstalk task definition.

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Security & Authentication (MANDATORY: Use strong random keys in production)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-minimum-32-characters
ADMIN_PASSWORD=replace-with-a-secure-admin-password

# Application Settings
NEXT_TELEMETRY_DISABLED=1

# Email Notifications (Optional - SMTP configuration for statutory deadline reminders)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ComplianceOS Alerts <alerts@yourcompany.com>"
SMTP_SECURE=false

# Database Path (Optional override - defaults to ./data/compliance.db)
# In AWS ECS / Docker, mount an EFS volume to /app/data
DATABASE_PATH=/app/data/compliance.db
